#!/usr/bin/env node
'use strict';

const { kickoff, prepare, status } = require('../control-plane/video-self-service/controller');

const EPISODE_PATTERN = /^EP[2-4]$/;
const RUN_ID_PATTERN = /^run_[a-z0-9]+_[a-z0-9]+$/;
const SHA256_PATTERN = /^[a-f0-9]{64}$/;

function parse(argv) {
  const [command, ...rest] = argv;
  if (command === 'prepare' && rest.length === 1 && EPISODE_PATTERN.test(rest[0])) return { command, episode: rest[0] };
  if (command === 'status' && rest.length === 1 && RUN_ID_PATTERN.test(rest[0])) return { command, runId: rest[0] };
  if (command === 'kickoff' && rest.length === 2 && RUN_ID_PATTERN.test(rest[0]) && SHA256_PATTERN.test(rest[1])) return { command, runId: rest[0], manifestSha256: rest[1] };
  throw new Error('Exact syntax required: prepare EP2|EP3|EP4 | status <run_id> | kickoff <run_id> <manifest_sha256>');
}

function main() {
  const args = parse(process.argv.slice(2));
  let result;
  if (args.command === 'prepare') result = prepare({ episode: args.episode });
  else if (args.command === 'status') result = status({ runId: args.runId });
  else result = kickoff(args);
  process.stdout.write(JSON.stringify(result, null, 2) + '\n');
  if (result.status === 'preflight_failed') process.exitCode = 1;
}

try { main(); } catch (error) { process.stderr.write(JSON.stringify({ status: 'error', error: error.message }) + '\n'); process.exitCode = 1; }
